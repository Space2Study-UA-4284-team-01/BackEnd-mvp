doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      body {
        background-color: #f5f5f5;
        margin: 0;
        padding: 40px 0;
        font-family: 'Open Sans', Arial, sans-serif;
      }
      .wrapper {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        padding: 60px 40px;
        text-align: center;
        border-radius: 4px;
      }
      .logo-box {
        margin-bottom: 40px;
        height: 30px;
      }
      .logo-img {
        height: 30px;
        width: auto;
      }
      .title {
        color: #263238;
        font-size: 36px;
        font-weight: 700;
        line-height: 1.2;
        margin: 0 0 32px 0;
      }
      .text {
        color: #263238;
        font-size: 18px;
        line-height: 1.6;
        margin-bottom: 40px;
      }
      .button {
        background-color: #263238;
        color: #ffffff !important;
        padding: 16px 40px;
        text-decoration: none;
        display: inline-block;
        font-size: 18px;
        font-weight: 700;
        border-radius: 4px;
      }
      .divider {
        margin: 60px auto 40px;
        width: 100%;
        max-width: 480px;
        border-top: 1px solid #eceff1;
      }
      .info-text {
        color: #607d8b;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 8px;
      }
      .user-email {
        color: #263238;
        font-weight: 700;
        text-decoration: none;
      }
      .footer {
        padding: 40px;
        text-align: center;
        color: #263238;
        font-size: 14px;
      }
      .footer-title {
        font-weight: 700;
        margin-bottom: 4px;
      }

  body
    div.wrapper
      div.logo-box
        //- Повний Base64 код логотипа Space2Study
        img.logo-img(src="data:image/svg+xml;base64," alt="Space2Study")
      
      h1.title Thank you for joining us
      
      p.text #{firstName}, please take a second to make sure we've got your email right.
      
      //- Посилання з токеном
      a.button(href=`http://localhost:3000/confirm-email?token=${confirmToken}`) Confirm your email
      
      div.divider
      
      p.info-text This is an automated email. Do not reply to this. You received this email because you are registered with SpaceToStudy at
      a.user-email(href=`mailto:${email}`) #{email}

    div.footer
      div.footer-title SpaceToStudy
      div © 2026 SpaceToStudy. All rights reserved.